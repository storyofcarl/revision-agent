# Revision Agent — key names (copy to .env and fill; .env is gitignored)

# BytePlus Ark — Seedance video (white renders, regen, video edit) and
# Seedream 5 Pro (default stills editor)
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# WaveSpeed — model API only (Nano Banana Pro, GPT-image editors). NOT hosting.
WAVESPEED_API_KEY=

# Supabase — file hosting (Ark requires web URLs for reference media)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=

# frame.io — adapter is a documented stub in v1; leave blank
FRAMEIO_TOKEN=
